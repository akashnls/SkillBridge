# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
# MongoDB connection connection string (local or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/skillbridge

# MongoDB reconnection retry parameters
MONGO_MAX_RETRIES=5
MONGO_RETRY_INTERVAL_MS=5000

# ── Auth & Security ────────────────────────────────────────────────────────────
# Secret key used for signing JWT tokens (use a long, cryptographically secure random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Secret key used for signing / verifying skill badge HMAC tokens
BADGE_SECRET_KEY=change-me-to-a-secure-badge-key

# WebAuthn / Passkey configuration (optional)
FRONTEND_ORIGIN=http://localhost:5173
RP_ID=localhost

# ── AI / Mock Interview ────────────────────────────────────────────────────────
# Optional: API key for Anthropic Claude (either ANTHROPIC_API_KEY or CLAUDE_API_KEY)
# Enables live AI-powered question generation and real-time candidate response evaluation.
# If omitted or left empty, the mock interview service automatically falls back to its
# built-in heuristic / algorithmic evaluation and dynamic question generation engine.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_API_KEY=your-anthropic-api-key-here

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Note: Email sending is disabled until real credentials are set.
# If SMTP_USER or SMTP_PASS is missing/empty, the server still starts normally,
# email sending is safely disabled (returns { success: false }), and a warning is logged.
#
# ── Option A: Gmail (recommended for production) ──────────────────────────────
# 1. Enable 2-Step Verification on your Google Account.
# 2. Go to: Google Account → Security → App Passwords.
# 3. Create an app password for "Mail" / "Other (SkillBridge)".
# 4. Paste the 16-character code as SMTP_PASS below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=SkillBridge

# ── Option B: Mailtrap sandbox (for local/CI testing only) ────────────────────
# Emails are captured in Mailtrap inbox — nothing is delivered to real addresses.
# Sign up free at https://mailtrap.io → Email Testing → SMTP Settings.
#
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password
# SMTP_FROM_EMAIL=noreply@skillbridge.com
# SMTP_FROM_NAME=SkillBridge
