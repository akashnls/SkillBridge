# ── Frontend Environment Configuration ──────────────────────────────────────────

# Base URL for backend API calls.
# - In local development: defaults to '/api' (forwarded via Vite dev server proxy to http://localhost:5001).
# - In production: set to the full URL of your deployed backend API (e.g. https://your-backend.com/api).
VITE_API_URL=/api
